# NOETARCH backend configuration. Copy to .env; NEVER commit real secrets.
NOETARCH_APP_NAME=noetarch-backend
NOETARCH_ENVIRONMENT=development
# Comma-separated explicit CORS allowlist. Empty = deny all cross-origin (default).
NOETARCH_CORS_ALLOW_ORIGINS=
# Load demo seed rows on the seed/startup path. Default ON. Set to false for "real mode":
# the schema is still created/migrated but no seed rows are inserted (clean, empty DB).
# The seed code is never removed — real data will come from the future workflow engine.
NOETARCH_SEED_DEMO=true
# External data sources (OpenAlex). Default OFF — the app runs fully offline on DB/seed
# data and makes NO outbound network call unless this is explicitly enabled.
NOETARCH_EXTERNAL_SOURCES_ENABLED=false
# Contact email for the polite User-Agent (OpenAlex polite pool). Not a secret.
NOETARCH_EGRESS_CONTACT_EMAIL=
